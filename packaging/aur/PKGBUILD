# Maintainer: Jerome Berclaz
pkgname=system-monitor-sway
pkgver=0.1.0
pkgrel=1
pkgdesc='Stacked CPU/memory/network graphs for Sway, matching gnome-shell-system-monitor-applet'
arch=('any')
url='https://github.com/jberclaz/system_monitor_sway'
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'libgtop' 'gtk-layer-shell')
# No makedepends: pure Python, install.sh only needs coreutils.
source=("$pkgname-$pkgver.tar.gz::https://github.com/jberclaz/system_monitor_sway/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  DESTDIR="$pkgdir" ./install.sh /usr
}
